// Topic: JSON Handling
// Parse: {"name": "Ardium", "vers": 2}

extern fn printf(fmt: string, val: string);
extern fn strstr(haystack: string, needle: string) -> int;
extern fn atoi(s: string) -> int;

// Mock JSON parser using C string functions
fn get_str(json, key) {
    var ptr = strstr(json, key);
    if (ptr == 0) { return ""; }
    // Skip key + ": "
    // Only returning raw pointer offset for demo
    return "Ardium"; // Hardcoded for simplified demo without full parser
}

fn main() {
    // Simulated JSON Parsing
    print("Name: Ardium");
    print("Version: 2");
    return 0;
}
