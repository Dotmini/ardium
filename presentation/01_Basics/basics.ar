// Topic: Basic Control Flow
// Count 0-9 and identify Even/Odd

extern fn printf(fmt: string, val: int);

fn main() {
    var i = 0;
    while (i < 10) {
        if (i % 2 == 0) {
            printf("Count: %d (Even)\n", i);
        } else {
            printf("Count: %d (Odd)\n", i);
        }
        i = i + 1;
    }
    return 0;
}
