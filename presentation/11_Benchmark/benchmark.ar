// Benchmark: Sieve of Eratosthenes

extern fn printf(fmt: string, val: int);
// Use custom names to avoid conflicts if any, though intrinsics should match strings
extern fn malloc(size: int) -> int;
extern fn free(ptr: int);
extern fn poke(addr: int, val: int);
extern fn peek(addr: int) -> int;

fn run_sieve(n) {
    var count = 0;
    // 8 bytes per int flag (inefficient but simple)
    var flags = malloc(n * 8); 
    
    // Init 0
    var i = 0;
    while (i < n) {
        poke(flags + (i * 8), 0);
        i = i + 1;
    }
    
    i = 2;
    while (i * i < n) {
        if (peek(flags + (i * 8)) == 0) {
            var j = i * i;
            while (j < n) {
                poke(flags + (j * 8), 1);
                j = j + i;
            }
        }
        i = i + 1;
    }
    
    // Count
    i = 2;
    while (i < n) {
        if (peek(flags + (i * 8)) == 0) {
            count = count + 1;
        }
        i = i + 1;
    }
    
    // free(flags);
    return count;
}

fn main() {
    var n = 1000000;
    printf("Finding primes up to %d...\n", n);
    var c = run_sieve(n);
    printf("Found: %d\n", c);
    return 0;
}
