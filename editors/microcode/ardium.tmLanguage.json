{
  "name": "Ardium",
  "scopeName": "source.ardium",
  "patterns": [
    {
      "name": "comment.line.double-slash.ardium",
      "match": "//.*$"
    },
    {
      "name": "keyword.control.ardium",
      "match": "\\b(if|else|while|for|return|break|continue|try|catch|match)\\b"
    },
    {
      "name": "keyword.declaration.ardium",
      "match": "\\b(fn|let|const|extern|class|struct|import)\\b"
    },
    {
      "name": "keyword.operator.ardium",
      "match": "(=|\\+|-|\\*|/|%|==|!=|<|>|<=|>=|&&|\\|\\||!)"
    },
    {
      "name": "storage.type.ardium",
      "match": "\\b(i32|i64|f32|f64|bool|string|ptr|void)\\b"
    },
    {
      "name": "constant.numeric.ardium",
      "match": "\\b\\d+(\\.\\d+)?\\b"
    },
    {
      "name": "string.quoted.double.ardium",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        {
          "name": "constant.character.escape.ardium",
          "match": "\\\\."
        }
      ]
    },
    {
      "name": "entity.name.function.ardium",
      "match": "\\b([a-zA-Z_][a-zA-Z0-9_]*)\\s*(?=\\()"
    },
    {
      "name": "entity.name.type.class.ardium",
      "match": "\\b([A-Z][a-zA-Z0-9_]*)\\b"
    },
    {
      "name": "meta.annotation.ardium",
      "match": "@[a-zA-Z_][a-zA-Z0-9_]*"
    }
  ]
}
