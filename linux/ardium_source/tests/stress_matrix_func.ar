fn main() {
    __sys_println("Matrix Func Test")
    test_matrix()
    return 0
}

fn test_matrix() {
    let size = 10
    let a = __sys_malloc(800)
    let b = __sys_malloc(800)
    let c = __sys_malloc(800)
    
    if (a == 0) { return 0; }
    if (b == 0) { return 0; }
    if (c == 0) { return 0; }
    
    matrix_fill(a, size, 2)
    matrix_fill(b, size, 3)
    
    let i = 0
    while (i < size) {
        let j = 0
        while (j < size) {
             let val = matrix_get(a, size, i, j)
             matrix_set(c, size, i, j, val)
             j = j + 1
        }
        i = i + 1
    }
    __sys_println("Func done")
    return 0
}

fn matrix_fill(m, size, val) {
    let count = size * size
    let i = 0
    while (i < count) {
        let offset = i * 8
        __builtin_poke(m + offset, val)
        i = i + 1
    }
    return 0
}

fn matrix_get(m, size, r, c) {
    let index = (r * size) + c
    let offset = index * 8
    let addr = m + offset
    let res = __builtin_peek(addr)
    return res
}

fn matrix_set(m, size, r, c, val) {
    let index = (r * size) + c
    let offset = index * 8
    let addr = m + offset
    __builtin_poke(addr, val)
    return 0
}
