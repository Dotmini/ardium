fn main() {
    __sys_println("Matrix Stress Test")
    
    let size = 10
    let a = __sys_malloc(800)
    let b = __sys_malloc(800)
    
    if (a == 0) { return 0; }
    if (b == 0) { return 0; }
    
    // Fill
    let c = __sys_malloc(800)
    if (c == 0) { return 0; }

    matrix_fill(a, size, 2)
    matrix_fill(b, size, 3)
    
    // Read and Write
    let i = 0
    while (i < size) {
        let j = 0
        while (j < size) {
            let val = matrix_get(a, size, i, j)
            // Write to C
            matrix_set(c, size, i, j, val)
            j = j + 1
        }
        i = i + 1
    }
    __sys_println("Write done")
    
    __sys_println("Done")
    return 0
}

fn matrix_fill(m, size, val) {
    let count = size * size
    __sys_print("Fill m: ")
    __builtin_print_int(m)
    let i = 0
    while (i < count) {
        let offset = i * 8
        __builtin_poke(m + offset, val)
        i = i + 1
    }
    return 0
}

fn matrix_get(m, size, r, c) {
    let index = (r * size) + c
    let offset = index * 8
    let addr = m + offset
    __sys_print("Peek addr: ")
    __builtin_print_int(addr)
    let res = __builtin_peek(addr)
    return res
}

fn matrix_set(m, size, r, c, val) {
    let index = (r * size) + c
    let offset = index * 8
    let addr = m + offset
    __builtin_poke(addr, val)
    return 0
}
