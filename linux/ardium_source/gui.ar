import "Core"
import "CoreUI"

// 1. HANDLERS
fn on_save() {
    println("Save Clicked");
}

fn on_cancel() {
    println("Cancel Clicked");
}

fn on_click() {
    println("Clicked!");
}

// 2. COMPONENTS
@VClass
fn MainLayout() {
    text("Title", 32, 1);
    text("Description", 16, 0);
}

@HClass
fn Toolbar() {
    // 3. CALLBACKS
    Button("Save", resolve_symbol("on_save"));
    Button("Cancel", resolve_symbol("on_cancel"));
    Button("Me", resolve_symbol("on_clack"));
}

// 4. MAIN
fn main() {
    init_apple_gui();
    viewer("Ass", 100, 100, 800, 600);
    set_modern_background();
    
    MainLayout();
    Toolbar();
    
    run_apple_gui();
    return 0;
}
