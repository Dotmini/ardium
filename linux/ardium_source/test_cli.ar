extern fn printf(fmt, ...);

@test
fn test_addition() {
    let result = 1 + 1;
    if (result == 2) {
        printf("✅ test_addition passed\n");
    } else {
        printf("❌ test_addition failed\n");
    }
}

@test
fn test_multiplication() {
    let result = 5 * 5;
    if (result == 25) {
        printf("✅ test_multiplication passed\n");
    } else {
        printf("❌ test_multiplication failed\n");
    }
}

fn main() {
    printf("Watcher detected changes and re-ran successfully!\n");
    return 0;
}
