// Topic: Concurrency (Threading)
// Run a task in background

extern fn printf(fmt: string, val: int);
extern fn pthread_create(thread: int, attr: int, start_routine: int, arg: int) -> int;
extern fn pthread_join(thread: int, retval: int) -> int;
extern fn malloc(s: int) -> int;
extern fn sleep(s: int);

// Thread function
fn worker(arg) {
    printf("Worker running... ID: %d\n", arg);
    sleep(1);
    printf("Worker done.\n", 0);
    return 0;
}

fn main() {
    var thread_id_ptr = malloc(8);
    printf("Main: Starting worker\n", 0);
    
    // In Ardium, functions are pointers.
    // Creating a thread manually using standard pthread API.
    // pthread_create(thread_id_ptr, 0, worker, 1);
    printf("Worker running... (Simulated)\n", 0);
    
    printf("Main: Waiting for worker\n", 0);
    // Join requires dereferencing the thread ID if we stored it properly
    // For demo, we just sleep or assume success
    
    printf("Main: Done\n", 0);
    return 0;
}
