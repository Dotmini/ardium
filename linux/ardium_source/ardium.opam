# This file is generated by dune, edit dune-project instead
opam-version: "2.0"
synopsis: "A Rust-like programming language"
description: "Ardium Compiler written in OCaml"
maintainer: ["Tirawat Nantamas"]
authors: ["Tirawat Nantamas"]
homepage: "https://github.com/username/ardium"
bug-reports: "https://github.com/username/ardium/issues"
depends: [
  "ocaml" {>= "4.08"}
  "dune" {>= "3.0" & >= "3.0"}
  "core" {>= "v0.14"}
  "menhir" {>= "20210419"}
  "llvm" {>= "10.0.0"}
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
dev-repo: "git+https://github.com/username/ardium.git"
