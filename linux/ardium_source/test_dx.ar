extern fn init_apple_gui();
extern fn create_apple_window(title, x, y, w, h);
extern fn run_apple_gui();
extern fn set_modern_background();
extern fn add_styled_text(s);

fn main() {
    init_apple_gui();
    create_apple_window("Test DX Repro", 100, 100, 800, 600);
    set_modern_background();
    add_styled_text("Hello DX World");
    run_apple_gui();
    return 0;
}
