fn gcd(a: int, b: int) -> int {
    if b == 0 { return a }
    return gcd(b, a % b)
}

fn primes_below(n: int) -> [int] {
    let mut sieve = [true; n]
    let mut out: [int] = []
    for i in 2..n {
        if sieve[i] {
            out.push(i)
            let mut j = i * i
            while j < n {
                sieve[j] = false
                j += i
            }
        }
    }
    return out
}

@test
fn test_gcd() {
    assert_eq(gcd(48, 18), 6)
    assert_eq(gcd(17, 5), 1)
}

@test
fn test_primes() {
    assert_eq(primes_below(20), [2, 3, 5, 7, 11, 13, 17, 19])
    assert_eq(primes_below(10000).len(), 1229)
}

@test
fn test_strings() {
    assert_eq("a-b".split("-"), ["a", "b"])
    assert(" x ".trim() == "x", "trim should strip spaces")
}
