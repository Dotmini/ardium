fn sum(xs: [int]) -> int {
    let mut t = 0
    for x in xs { t += x }
    return t
}

fn fill(mut xs: [int], v: int) {
    for i in 0..xs.len() { xs[i] = v }
}

fn main() {
    let mut a = [5, 3, 8, 1]
    println(a, a.len(), sum(a))
    a.push(7)
    a.sort()
    println(a)
    a.reverse()
    println(a, a.first(), a.last())
    println(a.pop(), a)
    a.insert(1, 42)
    println(a)
    println(a.remove(0), a)
    println(a.contains(42), a.contains(99), a.index_of(3), a.index_of(99))
    let b = a.copy()
    a[0] = -1
    println(a, b)
    println(a[1..3], a[..2], a[2..])
    let zeros = [0; 5]
    let words = ["hi"; 3]
    println(zeros, words)
    let grid = [[1, 2], [3, 4]]
    println(grid, grid[1][0])
    let mut m2: [[int]] = []
    for i in 0..3 {
        let mut row: [int] = []
        for j in 0..3 { row.push(i * j) }
        m2.push(row)
    }
    println(m2)
    m2[2][2] = 100
    println(m2[2])
    let floats = [1, 2.5, 3]
    println(floats)
    let mut c = [1, 2, 3]
    fill(c, 9)
    println(c)
    for i, v in ["a", "b", "c"] { print(f"{i}={v} ") }
    println()
    let mut strs = ["pear", "apple", "fig"]
    strs.sort()
    println(strs)
    a.clear()
    println(a, a.is_empty())
    println([1, 2] == [1, 2], [1, 2] == [2, 1], [[1]] == [[1]])
    let empty: [str] = []
    println(empty)
    let mut big: [int] = []
    for i in 0..100000 { big.push(i) }
    println(big.len(), big[99999])
}
