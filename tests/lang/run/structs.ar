struct Vec2 {
    x: float
    y: float
}

impl Vec2 {
    fn new(x: float, y: float) -> Vec2 {
        return Vec2 { x, y }
    }
    fn add(self, o: Vec2) -> Vec2 {
        return Vec2 { x: self.x + o.x, y: self.y + o.y }
    }
    fn length(self) -> float {
        return sqrt(self.x * self.x + self.y * self.y)
    }
    fn scale(mut self, k: float) {
        self.x *= k
        self.y *= k
    }
}

struct Account {
    owner: str,
    balance: int,
    history: [int],
}

impl Account {
    fn open(owner: str) -> Account {
        return Account { owner: owner, balance: 0, history: [] }
    }
    fn deposit(mut self, amount: int) {
        self.balance += amount
        self.history.push(amount)
    }
    fn describe(self) -> str {
        return f"{self.owner}: {self.balance} ({self.history.len()} txns)"
    }
}

struct Tree {
    value: int,
    left: ?Tree,
    right: ?Tree,
}

fn insert(t: ?Tree, v: int) -> Tree {
    if let n = t {
        if v < n.value {
            return Tree { value: n.value, left: insert(n.left, v), right: n.right }
        }
        return Tree { value: n.value, left: n.left, right: insert(n.right, v) }
    }
    return Tree { value: v, left: nil, right: nil }
}

fn in_order(t: ?Tree, mut out: [int]) {
    if let n = t {
        in_order(n.left, out)
        out.push(n.value)
        in_order(n.right, out)
    }
}

fn main() {
    let a = Vec2::new(3, 4)
    let b = Vec2 { x: 1.0, y: -1.0 }
    println(a.add(b), a.length())
    let mut c = a.add(b)
    c.scale(2)
    println(c)
    println(Vec2::length(a))
    let mut acct = Account::open("dot")
    acct.deposit(100)
    acct.deposit(50)
    println(acct.describe())
    println(acct)
    let mut root: ?Tree = nil
    for v in [50, 30, 70, 20, 40, 60, 80] { root = insert(root, v) }
    let mut out: [int] = []
    in_order(root, out)
    println(out)
    let pts = [Vec2::new(0, 0), Vec2::new(1, 1)]
    println(pts)
    println(Vec2::new(1, 2) == Vec2::new(1, 2), Vec2::new(1, 2) == Vec2::new(2, 1))
    // reference semantics: both names see the change
    let mut p = Vec2::new(1, 1)
    let q = p
    p.x = 9
    println(q.x)
}
