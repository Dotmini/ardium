fn main() {
    // for over ranges
    let mut s = 0
    for i in 0..10 { s += i }
    println(s)
    for i in 1..=5 { print(i, "") }
    println()
    // break / continue
    for i in 0..20 {
        if i % 2 == 0 { continue }
        if i > 9 { break }
        print(i, "")
    }
    println()
    // nested loops with break
    let mut found = 0
    for a in 1..20 {
        for b in a..20 {
            if a * b == 42 && a + b == 13 {
                found = a * 100 + b
                break
            }
        }
        if found != 0 { break }
    }
    println(found)
    // loop with break
    let mut n = 0
    loop {
        n += 3
        if n > 10 { break }
    }
    println(n)
    // while with complex condition
    let mut i = 0
    let mut j = 10
    while i < j && j - i > 2 {
        i += 1
        j -= 1
    }
    println(i, j)
    // shadowing
    let x = 5
    let x = x * 2
    {
        let x = "inner"
        println(x)
    }
    println(x)
    // short-circuit evaluation
    let xs: [int] = []
    if xs.len() > 0 && xs[0] == 1 { println("unreachable") } else { println("short-circuit ok") }
    // legacy forms
    let mut k = 0
    loop (k < 3) { k = k + 1; }
    while (k < 6) { k = k + 1; }
    println(k);
}
