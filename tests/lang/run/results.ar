struct Config { name: str, port: int }

fn parse_port(s: str) -> !int {
    let n = parse_int(s) ?? -1
    if n < 1 || n > 65535 { return err(f"invalid port '{s}'") }
    return n
}

fn parse_config(line: str) -> !Config {
    let parts = line.split("=")
    if parts.len() != 2 { return err(f"expected name=port, got '{line}'") }
    let port = parse_port(parts[1])?
    return Config { name: parts[0], port }
}

fn load_all(lines: [str]) -> ![Config] {
    let mut out: [Config] = []
    for l in lines { out.push(parse_config(l)?) }
    return out
}

fn check(flag: bool) -> !void {
    if !flag { return err("check failed") }
}

fn first_even(xs: [int]) -> ?int {
    for x in xs { if x % 2 == 0 { return x } }
    return nil
}

fn double_first_even(xs: [int]) -> ?int {
    let e = first_even(xs)?
    return e * 2
}

fn main() -> !void {
    println(load_all(["web=80", "db=5432"]))
    println(load_all(["web=80", "db=99999"]))
    println(load_all(["oops"]))
    match parse_config("api=8080") {
        ok(c) => println("loaded", c.name, c.port),
        err(e) => println("error:", e),
    }
    let r = parse_port("abc")
    println(r.is_err(), r.is_ok(), r.error(), r ?? 1, r.unwrap_or(2))
    if let p = parse_port("443") { println("port", p) } else { println("none") }
    println(check(true), check(false), check(false).error())
    println(double_first_even([1, 3, 4]), double_first_even([1, 3]))
    let results: [!int] = [parse_port("1"), parse_port("x"), 7]
    println(results, results[0] == parse_port("1"))
    check(true)?
    let n = parse_port("8000")?
    println("got", n)
    check(false)?
    println("not reached")
}
