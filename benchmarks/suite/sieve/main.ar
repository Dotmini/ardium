fn main() {
    let a = args()
    let mut n = 50000000
    if a.len() > 1 { n = a[1].to_int() ?? n }
    let mut sieve = [true; n + 1]
    sieve[0] = false
    sieve[1] = false
    let mut i = 2
    while i * i <= n {
        if sieve[i] {
            let mut j = i * i
            while j <= n {
                sieve[j] = false
                j += i
            }
        }
        i += 1
    }
    let mut count = 0
    for k in 0..=n {
        if sieve[k] { count += 1 }
    }
    println(count)
}
