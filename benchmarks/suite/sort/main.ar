fn main() {
    let a = args()
    let mut n = 5000000
    if a.len() > 1 { n = a[1].to_int() ?? n }
    let mut xs = [0; n]
    let mut x = 42
    for i in 0..n {
        x = (x * 1103515245 + 12345) % 2147483648
        xs[i] = x % 1000000000
    }
    xs.sort()
    let mut checksum = 0
    for i in 0..n { checksum = (checksum * 31 + xs[i]) % 1000000007 }
    println(xs[0], xs[n / 2], xs[n - 1], checksum)
}
