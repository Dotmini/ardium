struct Tree { left: ?Tree, right: ?Tree }

fn make(depth: int) -> Tree {
    if depth == 0 { return Tree { left: nil, right: nil } }
    return Tree { left: make(depth - 1), right: make(depth - 1) }
}

fn check(t: Tree) -> int {
    if let l = t.left {
        if let r = t.right { return 1 + check(l) + check(r) }
    }
    return 1
}

fn main() {
    let a = args()
    let mut max_depth = 18
    if a.len() > 1 { max_depth = parse_int(a[1]) ?? max_depth }
    let min_depth = 4
    let stretch = max_depth + 1
    println(f"stretch tree of depth {stretch}\t check: {check(make(stretch))}")
    let long_lived = make(max_depth)
    let mut d = min_depth
    while d <= max_depth {
        let iterations = 1 << (max_depth - d + min_depth)
        let mut total = 0
        for _ in 0..iterations { total += check(make(d)) }
        println(f"{iterations}\t trees of depth {d}\t check: {total}")
        d += 2
    }
    println(f"long lived tree of depth {max_depth}\t check: {check(long_lived)}")
}
