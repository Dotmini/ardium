fn arg_or(d: int) -> int {
    let a = args()
    if a.len() > 1 { return parse_int(a[1]) ?? d }
    return d
}

fn main() {
    let n = arg_or(50000000)
    let mut sieve = [true; n + 1]
    sieve[0] = false
    sieve[1] = false
    let mut i = 2
    while i * i <= n {
        if sieve[i] {
            let mut j = i * i
            while j <= n {
                sieve[j] = false
                j += i
            }
        }
        i += 1
    }
    let mut count = 0
    for k in 0..=n {
        if sieve[k] { count += 1 }
    }
    println(count)
}
