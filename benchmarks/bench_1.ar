
let limit = 15000;
let mut count = 0;
let mut n = 2;
let mut d = 2;
let mut is_prime = 1;

fn main() {
    while (n <= limit) {
        is_prime = 1;
        d = 2;
        while (d * d <= n) {
            if (n % d == 0) {
                is_prime = 0;
                d = n;
            } else {
                d = d + 1;
            }
        }
        if (is_prime == 1) {
            count = count + 1;
        }
        n = n + 1;
    }
    println(count);
}
