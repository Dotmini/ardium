
let n = 1500;
let mod = 1000000007;
let mut grand_total = 0;
let mut i = 1;
let mut j = 1;

fn main() {
    while (i <= n) {
        j = 1;
        while (j <= i) {
            grand_total = (grand_total + (i * j)) % mod;
            j = j + 1;
        }
        i = i + 1;
    }
    println(grand_total);
}
