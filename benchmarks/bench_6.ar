
let mut total_gcd = 0;
let mut i = 1;
let mut a = 1;
let mut b = 2520;
let mut t = 0;

fn main() {
    while (i <= 200000) {
        a = i;
        b = 2520;
        while (b != 0) {
            t = b;
            b = a % b;
            a = t;
        }
        total_gcd = total_gcd + a;
        i = i + 1;
    }
    println(total_gcd);
}
