
let base = 7;
let exp = 256;
let mod = 1000000007;
let mut checksum = 0;
let mut iter = 0;
let mut res = 1;
let mut b = 7;
let mut e = 256;

fn main() {
    while (iter < 100000) {
        res = 1;
        b = base;
        e = exp;
        while (e > 0) {
            if (e % 2 == 1) {
                res = (res * b) % mod;
            }
            b = (b * b) % mod;
            e = e / 2;
        }
        checksum = (checksum + res) % mod;
        iter = iter + 1;
    }
    println(checksum);
}
